{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      // Registry sources import through `@/` exactly as a consumer will after
      // the CLI rewrites them. Explicit entries go here, above the `@/*`
      // wildcard, so they win and the same file typechecks in both workspaces.
      //
      // Each new item needs an entry here and in registry/tsconfig.json;
      // lint-registry fails the build when either one is missing.
      "@/components/z-ui/disclosure": ["../registry/components/disclosure/disclosure.tsx"],
      "@/components/z-ui/hold-drain": ["../registry/components/hold-drain/hold-drain.tsx"],
      "@/components/z-ui/scramble-reveal": [
        "../registry/components/scramble-reveal/scramble-reveal.tsx"
      ],
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
