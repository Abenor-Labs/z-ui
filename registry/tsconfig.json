{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No `baseUrl`: TypeScript 7 removed it, and paths now resolve relative
    // to this file's directory.
    // Registry sources import via the same `@/` specifiers a consumer will
    // have after the CLI rewrites them, so what typechecks here is what ships.
    // Entries are explicit per item because our folder-plus-manifest layout
    // nests each source one level deeper than it lands in a consumer project
    // (lib/z-spring/z-spring.ts here, lib/z-spring.ts there), and tsconfig
    // paths allow only one wildcard per pattern.
    //
    // Every new item needs its entry added here and in web/tsconfig.json;
    // lint-registry fails the build when one is missing, so a forgotten entry
    // cannot reach CI.
    "paths": {
      "@/components/z-ui/chase": ["./components/chase/chase.tsx"],
      "@/components/z-ui/dial": ["./components/dial/dial.tsx"],
      "@/components/z-ui/disclosure": ["./components/disclosure/disclosure.tsx"],
      "@/components/z-ui/hold-drain": ["./components/hold-drain/hold-drain.tsx"],
      "@/components/z-ui/heft": ["./components/heft/heft.tsx"],
      "@/components/z-ui/late-critique": ["./components/late-critique/late-critique.tsx"],
      "@/components/z-ui/scramble-reveal": ["./components/scramble-reveal/scramble-reveal.tsx"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
