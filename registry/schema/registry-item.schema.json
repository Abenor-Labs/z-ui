{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Abenor-Labs/z-ui/main/registry/schema/registry-item.schema.json",
  "title": "Z-UI registry item",
  "description": "A strict superset of shadcn's registry-item schema. Z-UI fields live under `meta`, which shadcn ignores, so `npx shadcn add <url>` works on these manifests unmodified.",
  "type": "object",
  "required": ["name", "type", "title", "description", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "kebab-case, and identical to the directory name."
    },
    "type": {
      "enum": ["registry:component", "registry:hook", "registry:lib"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "npm packages the CLI installs."
    },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other registry item names, resolved transitively."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "type": { "enum": ["registry:component", "registry:hook", "registry:lib"] },
          "target": { "type": "string" }
        }
      }
    },
    "tailwind": { "type": "object" },
    "cssVars": { "type": "object" },
    "meta": {
      "type": "object",
      "required": ["category"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": ["primitive", "tactile-feedback", "state-morphing", "input-utility"]
        },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": "Every value data-state can take. Must equal the component's STATES tuple and the keys of every variants object."
        },
        "spring": { "enum": ["snap", "bounce", "settle", "fling"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "registry:component" } } },
      "then": {
        "required": ["meta"],
        "properties": {
          "meta": { "required": ["category", "states", "spring"] }
        },
        "description": "Components must declare their state machine and default spring; the showcase builds its state inspector from these."
      }
    }
  ]
}
